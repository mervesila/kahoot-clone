# Backend veritabanı bağlantısı.
# Program.cs, önce DATABASE_URL ortam değişkenine bakar; ayarlı değilse
# appsettings.json içindeki ConnectionStrings:DefaultConnection kullanılır.

# Docker ortamı (docker-compose backend servisi içinde otomatik set edilir)
DATABASE_URL=postgresql://postgres:postgres@db:5432/kahoot_db

# Yerel geliştirme (docker compose up -d db sonrası localhost'ta çalışan backend için)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kahoot_db

# JWT imzalama anahtarı (en az 32 karakter). Ayarlanmazsa appsettings.json'daki
# Jwt:Key kullanılır; bu değer üretimde ASLA dosyaya yazılmamalıdır.
JWT_KEY=change-me-to-a-long-random-secret-of-32+-chars
